# Required — PostgreSQL connection string (use a real password in production)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rentify?schema=public"

# Required — HTTP port for the API process
PORT=4000

# Required for production deploys: development | test | production
NODE_ENV=development

# Required — at least 32 characters; generate a unique value per environment.
# Never commit a real production secret.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=7d

# Required in production when frontend and API are on different origins.
# Comma-separated list of exact browser origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# In development, http://localhost:* and http://127.0.0.1:* are allowed automatically.
# Leave empty in production only if the frontend is served same-origin from the API host.
CORS_ALLOWED_ORIGINS=

# Frontend build-time variable (Vite). Absolute API base URL for production builds.
# Leave unset in local development (falls back to http://localhost:4000).
# Example: VITE_API_BASE_URL=https://api.example.com
# If unset in a production build, the app uses same-origin relative /api paths.
VITE_API_BASE_URL=

# Email delivery for password reset (production)
# Leave EMAIL_PROVIDER empty or "none" for local development (dev reset file is used).
# In NODE_ENV=production, password reset fails with a clear server-side configuration
# error until a real provider is configured and EMAIL_RESET_BASE_URL is set.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
# Public app base used in reset links, e.g. https://app.example.com
# Required in production when password reset is enabled.
EMAIL_RESET_BASE_URL=
# Optional override for the local development reset-link file
# PASSWORD_RESET_DEV_FILE=
